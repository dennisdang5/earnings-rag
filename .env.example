# --- Database --------------------------------------------------------------
# Defaults match docker-compose.yml for local development.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=earnings

# "disable" locally and in CI; set to "require" when pointing at RDS.
DB_SSLMODE=disable

# --- OpenAI ----------------------------------------------------------------
# Can be the same key for both.
EMBEDDING_API_KEY=
LLM_API_KEY=

# --- SEC EDGAR -------------------------------------------------------------
# Required for ingestion only. The SEC asks for a name and contact email,
# and returns 403 without one.
SEC_USER_AGENT=Your Name your-email@example.com
